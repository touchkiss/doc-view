<idea-plugin require-restart="false">
    <id>com.liuzhihang.doc-view</id>
    <name>Doc View</name>
    <vendor email="liuzhihangs@qq.com" url="https://liuzhihang.com">Liu ZhiHang</vendor>
    <resource-bundle>messages.DocViewBundle</resource-bundle>

    <description><![CDATA[ Description will be added by gradle build]]></description>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.platform.vcs</depends>
    <depends>com.intellij.xml</depends>
    <!-- 暂时不打开预览 -->
    <depends>org.intellij.plugins.markdown</depends>
    <!-- JCEF 嵌入式浏览器（2026.2 起为独立捆绑插件），用于 HTML 文档预览 -->
    <depends>com.intellij.modules.jcef</depends>
    <!-- Protocol Buffers 插件，用于解析 .proto message 结构；缺失时插件仍可正常加载 -->
    <depends optional="true" config-file="doc-view-protobuf.xml">idea.plugin.protoeditor</depends>
    <!-- Native HTTP enhancement is part of Doc View, activated only when HTTP Client is enabled. -->
    <depends optional="true" config-file="doc-view-http-client.xml">com.jetbrains.restClient</depends>

    <depends optional="true" config-file="doc-view-kdoc.xml">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.liuzhihang.doc.view.config.EasyDocConfigComponent"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.javadoc.service.JavaDocGeneratorServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.WriterService"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.PackageInfoService"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.translator.TranslatorService"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.javadoc.service.variable.JavadocVariableGeneratorService"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.gpt.GptService"/>

        <applicationConfigurable id="easydoc.common.settings" parentId="liuzhihang.api.doc.SettingsConfigurable" displayName="源码注释与 AI" instance="com.liuzhihang.doc.view.view.settings.CommonSettingsConfigurable"/>

        <applicationConfigurable parentId="easydoc.common.settings" id="easydoc.javadoc.settings" displayName="Java 注释" instance="com.liuzhihang.doc.view.view.settings.javadoc.JavadocSettingsConfigurable">
            <configurable parentId="easydoc.javadoc.settings" displayName="类注释模板" instance="com.liuzhihang.doc.view.view.settings.javadoc.template.ClassSettingsConfigurable"/>
            <configurable parentId="easydoc.javadoc.settings" displayName="方法注释模板" instance="com.liuzhihang.doc.view.view.settings.javadoc.template.MethodSettingsConfigurable"/>
            <configurable parentId="easydoc.javadoc.settings" displayName="字段注释模板" instance="com.liuzhihang.doc.view.view.settings.javadoc.template.FieldSettingsConfigurable"/>
        </applicationConfigurable>


        <!-- Add your extensions here -->
        <!--Application 级别配置-->
        <applicationService serviceImplementation="com.liuzhihang.doc.view.config.ApplicationSettings"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.mcp.McpServerService"/>
        <!-- 一个项目一个设置 -->
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.Settings"/>
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.WindowSettings"/>
        <!-- 模版设置 -->
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.TemplateSettings"/>
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.YApiSettings"/>
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.ShowDocSettings"/>
        <projectService serviceImplementation="com.liuzhihang.doc.view.config.YuQueSettings"/>

        <!-- 相关服务 -->
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.SpringDocViewServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.PojoDocViewServiceImpl"/>

        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.DubboDocViewServiceImpl"/>

        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.YApiServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.integration.impl.YApiFacadeServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.ShowDocServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.integration.impl.ShowDocFacadeServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.service.impl.YuQueServiceImpl"/>
        <applicationService serviceImplementation="com.liuzhihang.doc.view.integration.impl.YuQueFacadeServiceImpl"/>

        <postStartupActivity implementation="com.liuzhihang.doc.view.mcp.McpStartupActivity"/>

        <!-- provider -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.liuzhihang.doc.view.provider.DocViewLineMarkerProvider"/>

        <!-- 配置为项目等级 全局为 applicationConfigurable -->
        <projectConfigurable instance="com.liuzhihang.doc.view.config.SettingsConfigurable"
                             id="liuzhihang.api.doc.SettingsConfigurable"
                             parentId="tools"
                             bundle="messages.DocViewBundle" key="settings.page.root"
                             nonDefaultProject="true"/>

        <applicationConfigurable instance="com.liuzhihang.doc.view.config.McpSettingsConfigurable"
                                 id="liuzhihang.api.doc.McpSettingsConfigurable"
                                 parentId="liuzhihang.api.doc.IntegrationSettingsConfigurable"
                                 displayName="MCP 服务"/>

        <projectConfigurable instance="com.liuzhihang.doc.view.config.GenerationRulesConfigurable"
                             id="liuzhihang.api.doc.GenerationRulesConfigurable"
                             parentId="liuzhihang.api.doc.SettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.rules"
                             nonDefaultProject="true"/>

        <projectConfigurable instance="com.liuzhihang.doc.view.config.TemplateConfigurable"
                             id="liuzhihang.api.doc.TemplateConfigurable"
                             parentId="liuzhihang.api.doc.SettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.template"
                             nonDefaultProject="true"/>

        <projectConfigurable instance="com.liuzhihang.doc.view.config.IntegrationSettingsConfigurable"
                             id="liuzhihang.api.doc.IntegrationSettingsConfigurable"
                             parentId="liuzhihang.api.doc.SettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.integrations"
                             nonDefaultProject="true"/>

        <projectConfigurable instance="com.liuzhihang.doc.view.config.YApiSettingsConfigurable"
                             id="liuzhihang.api.doc.YApiSettingsConfigurable"
                             parentId="liuzhihang.api.doc.IntegrationSettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.yapi"
                             nonDefaultProject="true"/>

        <projectConfigurable instance="com.liuzhihang.doc.view.config.ShowDocSettingsConfigurable"
                             id="liuzhihang.api.doc.ShowDocSettingsConfigurable"
                             parentId="liuzhihang.api.doc.IntegrationSettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.showdoc"
                             nonDefaultProject="true"/>
        <projectConfigurable instance="com.liuzhihang.doc.view.config.YuQueSettingsConfigurable"
                             id="liuzhihang.api.doc.YuQueSettingsConfigurable"
                             parentId="liuzhihang.api.doc.IntegrationSettingsConfigurable"
                             bundle="messages.DocViewBundle" key="settings.page.yuque"
                             nonDefaultProject="true"/>

        <search.optionContributor implementation="com.liuzhihang.doc.view.config.DocViewSearchableOptionContributor"/>

        <toolWindow id="Doc View"
                    icon="DocViewIcons.DOC_VIEW"
                    anchor="right"
                    secondary="false"
                    doNotActivateOnStart="true"
                    order="last"
                    factoryClass="com.liuzhihang.doc.view.ui.window.DocViewToolWindowFactory"/>

        <!-- 2020.3 需要使用 notificationGroup 配置通知 -->
        <notificationGroup id="doc-view.NotificationGroup" displayType="BALLOON"/>

        <!-- xml 解析的扩展, 解析 SpringBeans-->
        <dom.fileMetaData implementation="com.liuzhihang.doc.view.dom.BeansDescription"/>
        <!-- 范围搜索 -->
        <definitionsScopedSearch implementation="com.liuzhihang.doc.view.dom.DubboDefinitionSearch"/>

        <!-- 浮动按钮 -->
        <!--<editorFloatingToolbarProvider-->
        <!--        id="com.liuzhihang.doc.view.editor.floating"-->
        <!--        order="after DefaultFloatingToolbarProvider"-->
        <!--        implementation="com.liuzhihang.doc.view.ui.editor.EditorFloatingToolbarProvider"/>-->

        <!--<extensionPoint name="iw.actionProvider" interface="com.intellij.openapi.editor.markup.InspectionWidgetActionProvider" dynamic="true"/>-->

        <!--<iw.actionProvider implementation="com.liuzhihang.doc.view.provider.DocViewActionProvider"/>-->


    </extensions>

    <actions>
        <action id="liuzhihang.doc.sourceComments.generateAll" class="com.liuzhihang.doc.view.action.GenerateAllJavadocAction" text="批量生成 Javadoc">
            <add-to-group group-id="JavaGenerateGroup1" anchor="before" relative-to-action="GenerateEquals"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl shift BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl shift BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift BACK_SLASH"/>
        </action>

        <!-- Add your actions here -->
        <group id="liuzhihang.doc.sourceComments" text="Doc View 源码注释" popup="true">

            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="liuzhihang.doc.sourceComments.generate" class="com.liuzhihang.doc.view.action.GenerateJavadocAction" text="生成注释或翻译选区">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl BACK_SLASH" replace-all="true"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl BACK_SLASH" replace-all="true"/>
            </action>
            <reference ref="liuzhihang.doc.sourceComments.generateAll"/>
            <action id="liuzhihang.doc.sourceComments.generateMembers"
                    class="com.liuzhihang.doc.view.action.GenerateClassMembersJavadocAction" text="生成全部成员注释">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt BACK_SLASH"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt BACK_SLASH"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt BACK_SLASH"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt BACK_SLASH"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt BACK_SLASH"/>
            </action>
            <action id="liuzhihang.doc.sourceComments.analyzeTerms" class="com.liuzhihang.doc.view.glossary.AnalyzeProjectTermsAction"
                    text="AI 分析项目术语"/>
        </group>

        <!-- Add your actions here -->

        <group id="liuzhihang.doc" popup="false" compact="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="liuzhihang.doc.view" class="com.liuzhihang.doc.view.action.PreviewAction" text="Doc View"/>
            <action id="liuzhihang.doc.editor" class="com.liuzhihang.doc.view.action.EditorAction" text="Doc Editor"
                    description="Edit and copy documentation drafts without changing source"/>
            <group id="liuzhihang.doc.copy.rest" text="Copy As" popup="true" compact="true">
                <action id="liuzhihang.doc.copy.curl" class="com.liuzhihang.doc.view.action.CopyCurlAction" text="cURL"/>
                <action id="liuzhihang.doc.copy.rest.json" class="com.liuzhihang.doc.view.action.CopyRestRequestAction$Json" text="REST Request (JSON)"/>
                <action id="liuzhihang.doc.copy.rest.json5" class="com.liuzhihang.doc.view.action.CopyRestRequestAction$Json5" text="REST Request (JSON5)"/>
                <action id="liuzhihang.doc.copy.postman" class="com.liuzhihang.doc.view.action.CopyPostmanAction" text="Postman"/>
                <action id="liuzhihang.doc.grpc.copy.curl" class="com.liuzhihang.doc.view.action.ProtoGrpcCopyCurlAction" text="cURL"/>
                <action id="liuzhihang.doc.grpc.copy.rest.json" class="com.liuzhihang.doc.view.action.ProtoGrpcCopyRestAction$Json" text="REST Request (JSON)"/>
                <action id="liuzhihang.doc.grpc.copy.rest.json5" class="com.liuzhihang.doc.view.action.ProtoGrpcCopyRestAction$Json5" text="REST Request (with field comments)"/>
            </group>
        </group>

        <group id="liuzhihang.doc.upload" text="Doc Upload" popup="true">
            <add-to-group group-id="liuzhihang.doc" anchor="last"/>
            <action id="liuzhihang.doc.yapi.upload" class="com.liuzhihang.doc.view.action.upload.YApiUploadAction"
                    text="Upload to YApi"/>

            <action id="liuzhihang.doc.showdoc.upload" class="com.liuzhihang.doc.view.action.upload.ShowDocUploadAction"
                    text="Upload to ShowDoc"/>
            <action id="liuzhihang.doc.yuque.upload" class="com.liuzhihang.doc.view.action.upload.YuQueUploadAction"
                    text="Upload to YuQue"/>
        </group>

        <!-- preview 界面目录左下角toolbar -->
        <group id="liuzhihang.doc.preview.toolbar.menu">
            <action id="liuzhihang.doc.preview.toolbar.menu.export"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.MenuExportAllAction"
                    text="Export All" description="Export Markdown" icon="AllIcons.Ide.IncomingChangesOn"/>
            <action id="liuzhihang.doc.preview.toolbar.menu.upload"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.MenuUploadAllAction"
                    text="Upload All" description="Upload all documents" icon="AllIcons.Ide.OutgoingChangesOn"/>
        </group>

        <!-- preview 界面目录右下角 右侧toolbar -->
        <group id="liuzhihang.doc.preview.toolbar.right">
            <action id="liuzhihang.doc.preview.toolbar.right.upload"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.PreviewRightUploadAction"
                    text="Upload" description="Upload documents" icon="AllIcons.Actions.Upload"/>
            <action id="liuzhihang.doc.preview.toolbar.right.export"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.PreviewRightExportAction"
                    text="Export" description="Export Markdown" icon="AllIcons.ToolbarDecorator.Export"/>
            <action id="liuzhihang.doc.preview.toolbar.toolbar.copy"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.PreviewRightCopyAction"
                    text="Copy" description="Copy to clipboard" icon="AllIcons.Actions.Copy"/>
        </group>

        <!-- editor 右键菜单 -->
        <group id="liuzhihang.doc.preview.editor.floating">

            <action id="liuzhihang.doc.preview.editor.save"
                    class="com.liuzhihang.doc.view.action.toolbar.preview.MenuExportAllAction"
                    text="Save" icon="AllIcons.Actions.MenuSaveall"/>

        </group>


        <!-- ToolWindow 的工具栏  -->
        <group id="liuzhihang.doc.tool.window.toolbar.action">

            <action id="liuzhihang.doc.tool.window.toolbar.action.refresh"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowRefreshAction"
                    text="Refresh" description="Refresh" icon="DocViewIcons.REFRESH"/>
            <separator/>
            <group id="liuzhihang.doc.tool.window.toolbar.action.export.menu"
                   popup="true" text="Export" description="Export Doc View documents"
                   icon="AllIcons.ToolbarDecorator.Export">
                <action id="liuzhihang.doc.tool.window.toolbar.action.export"
                        class="com.liuzhihang.doc.view.action.toolbar.window.WindowExportAction"
                        text="Export Markdown" description="Export Markdown" icon="DocViewIcons.EXPORT"/>
                <action id="liuzhihang.doc.tool.window.toolbar.action.project.export"
                        class="com.liuzhihang.doc.view.action.toolbar.window.ProjectDocumentExportAction"
                        text="Export Project Docs" description="Export project API documentation" icon="AllIcons.ToolbarDecorator.Export"/>
            </group>
            <action id="liuzhihang.doc.tool.window.toolbar.action.upload"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowUploadAction"
                    text="Upload" description="Upload documents" icon="DocViewIcons.UPLOAD"/>

            <separator/>
            <action id="liuzhihang.doc.tool.window.toolbar.action.expand"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowExpandAction"
                    text="Expand" description="Expand" icon="DocViewIcons.EXPAND_ALL"/>
            <action id="liuzhihang.doc.tool.window.toolbar.action.collapse"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowCollapseAction"
                    text="Collapse" description="Collapse" icon="DocViewIcons.COLLAPSE_ALL"/>

            <separator/>
            <action id="liuzhihang.doc.tool.window.toolbar.action.clear"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowClearAction"
                    text="Clear Cache" description="Clear the current project's Doc View schema cache; generated documents are preserved." icon="DocViewIcons.CLEAR"/>
            <separator/>
            <action id="liuzhihang.doc.tool.window.toolbar.action.setting"
                    class="com.liuzhihang.doc.view.action.toolbar.window.WindowSettingsAction"
                    text="Settings" description="Open Doc View settings" icon="DocViewIcons.SETTINGS"/>
            <separator/>

        </group>


        <!-- ToolWindow 目录右键菜单  -->
        <group id="liuzhihang.doc.tool.window.catalog.action">

            <reference ref="EditSource"/>

            <action id="liuzhihang.doc.tool.window.catalog.action.open"
                    class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogOpenAction"
                    text="Open" description="Open" icon="DocViewIcons.EDITOR_PREVIEW"/>

            <action id="liuzhihang.doc.tool.window.catalog.action.previewSource"
                    class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogPreviewSourceAction"
                    text="预览文档并调整注释" icon="DocViewIcons.EDITOR_PREVIEW"/>

            <action id="liuzhihang.doc.tool.window.catalog.action.export"
                    class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogExportAction"
                    text="Export" description="Export Markdown" icon="DocViewIcons.EXPORT"/>

            <group id="liuzhihang.doc.tool.window.catalog.action.upload" popup="true" text="Upload" description="Upload documents"
                   icon="DocViewIcons.UPLOAD">
                <action id="liuzhihang.doc.tool.window.catalog.action.upload.yapi"
                        class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogUploadYApiAction"
                        text="Upload to YApi" description="YApi"/>
                <action id="liuzhihang.doc.tool.window.catalog.action.upload.showdoc"
                        class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogUploadShowDocAction"
                        text="Upload to ShowDoc" description="ShowDoc"/>
                <action id="liuzhihang.doc.tool.window.catalog.action.upload.yuque"
                        class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogUploadYuQueAction"
                        text="Upload to YuQue" description="YuQue"/>
            </group>
            <separator/>
            <action id="liuzhihang.doc.tool.window.catalog.action.clear"
                    class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogClearAction"
                    text="Clear Cache" description="Clear the current project's Doc View schema cache; generated documents are preserved." icon="DocViewIcons.CLEAR"/>

            <action id="liuzhihang.doc.view.action.toolbar.window.catalog.httpclient"
                    class="com.liuzhihang.doc.view.action.toolbar.window.catalog.CatalogHttpClientAction"
                    text="HTTP Client"
                    description="Generate an HTTP client request" icon="DocViewIcons.HTTP_API">
            </action>
        </group>

    </actions>
</idea-plugin>
